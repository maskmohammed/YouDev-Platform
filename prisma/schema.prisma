// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================================================
// ENUMS
// =======================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum EditionStatus {
  DRAFT
  ACTIVE
  VOTING_OPEN
  VOTING_CLOSED
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  DISQUALIFIED
  ARCHIVED
}

enum MediaType {
  VIDEO
  THUMBNAIL
  PREVIEW
  EXPORT_FILE
}

enum MediaProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum SessionType {
  USER
  ADMIN
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

enum VoteStatus {
  VALID
  REMOVED_BY_ADMIN
  SUSPECT
  INVALID
}

enum FraudType {
  MULTI_ACCOUNT
  SAME_IP_MANY_VOTES
  FAST_VOTING
  SUSPICIOUS_USER_AGENT
  BANNED_USER_ATTEMPT
  DUPLICATE_VOTE_ATTEMPT
  VOTE_LIMIT_ATTEMPT
  IP_RATE_LIMIT
  DEVICE_SUSPICIOUS
  OTHER
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudStatus {
  OPEN
  REVIEWING
  RESOLVED
  IGNORED
}

enum ExportType {
  LEADERBOARD
  VOTES
  USERS
  TEAMS
  PROJECTS
  FRAUD_ALERTS
  AUDIT_LOGS
  FULL_REPORT
}

enum ExportFormat {
  CSV
  XLSX
}

enum ExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum BanType {
  USER
  IP
  DEVICE
}

enum BanStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  FRAUD
  SYSTEM
  EXPORT
  MEDIA
}

enum ScoreSnapshotType {
  LIVE
  BEFORE_FREEZE
  FINAL
  MANUAL
}

// =======================================================
// USERS — VOTANTS INSTAGRAM
// =======================================================

model User {
  id String @id @default(cuid())

  instagramId String @unique
  name        String?
  username    String @unique
  avatarUrl   String?

  isBanned  Boolean @default(false)
  banReason String?

  lastLoginAt   DateTime?
  lastIpAddress String?
  lastUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes        Vote[]
  voteAttempts VoteAttempt[]
  sessions     Session[]
  fraudAlerts  FraudAlert[]
  auditLogs    AuditLog[]
  bans         Ban[]
  projectViews ProjectView[]

  @@index([instagramId])
  @@index([username])
  @@index([isBanned])
  @@index([lastIpAddress])
  @@map("users")
}

// =======================================================
// ADMINS
// =======================================================

model Admin {
  id String @id @default(cuid())

  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)

  lastLoginAt   DateTime?
  lastIpAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]
  exports       ExportHistory[]
  removedVotes  Vote[]         @relation("VoteRemovedByAdmin")
  bansCreated   Ban[]          @relation("BanCreatedByAdmin")
  notifications Notification[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("admins")
}

// =======================================================
// COMPETITION EDITIONS
// =======================================================

model CompetitionEdition {
  id String @id @default(cuid())

  name   String
  slug   String @unique
  year   Int    @unique
  status EditionStatus @default(DRAFT)

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config         CompetitionConfig?
  teams          Team[]
  projects       Project[]
  votes          Vote[]
  voteAttempts   VoteAttempt[]
  fraudAlerts    FraudAlert[]
  exports        ExportHistory[]
  scoreSnapshots ScoreSnapshot[]

  @@index([status])
  @@index([year])
  @@map("competition_editions")
}

// =======================================================
// COMPETITION CONFIG
// =======================================================

model CompetitionConfig {
  id String @id @default(cuid())

  editionId String @unique
  edition   CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  maxVotesPerUser    Int @default(3)
  maxVotesPerProject Int @default(1)
  qualifiedCount     Int @default(10)

  isVotingOpen Boolean @default(false)
  isFrozen     Boolean @default(false)

  votingStartAt DateTime?
  votingEndAt   DateTime?

  allowPublicLeaderboard Boolean @default(true)
  showExactVotes         Boolean @default(true)
  allowProjectViews      Boolean @default(true)

  maxVideoSizeMb Int @default(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("competition_config")
}

// =======================================================
// TEAMS
// =======================================================

model Team {
  id String @id @default(cuid())

  editionId String
  edition   CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  logoUrl     String?
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  projects Project[]

  @@unique([editionId, slug])
  @@index([editionId])
  @@index([name])
  @@index([isActive])
  @@map("teams")
}

// =======================================================
// PROJECTS
// =======================================================

model Project {
  id String @id @default(cuid())

  editionId String
  edition   CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  teamId String
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  projectName String
  slug        String
  description String?

  thumbnailUrl String?
  videoUrl     String?

  status      ProjectStatus @default(DRAFT)
  isPublished Boolean       @default(false)
  isFeatured  Boolean       @default(false)

  viewCount    Int @default(0)
  displayOrder Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  votes          Vote[]
  voteAttempts   VoteAttempt[]
  mediaFiles     MediaFile[]
  fraudAlerts    FraudAlert[]
  auditLogs      AuditLog[]
  views          ProjectView[]
  technologies   ProjectTechnology[]
  scoreSnapshots ScoreSnapshot[]

  @@unique([editionId, slug])
  @@index([editionId])
  @@index([teamId])
  @@index([status])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([projectName])
  @@map("projects")
}

// =======================================================
// TECHNOLOGIES
// =======================================================

model Technology {
  id String @id @default(cuid())

  name String @unique
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectTechnology[]

  @@map("technologies")
}

model ProjectTechnology {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technologies")
}

// =======================================================
// MEDIA FILES
// =======================================================

model MediaFile {
  id String @id @default(cuid())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type MediaType

  storageProvider String?
  storagePath     String?

  originalUrl  String?
  optimizedUrl String?
  thumbnailUrl String?
  previewUrl   String?

  fileName String?
  mimeType String?
  size     Int?

  durationSeconds Int?
  width           Int?
  height          Int?

  processingStatus MediaProcessingStatus @default(PENDING)
  processingError  String?
  processedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs MediaJob[]

  @@index([projectId])
  @@index([type])
  @@index([processingStatus])
  @@index([createdAt])
  @@map("media_files")
}

// =======================================================
// MEDIA JOBS
// =======================================================

model MediaJob {
  id String @id @default(cuid())

  mediaFileId String
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  status MediaProcessingStatus @default(PENDING)

  attempts     Int @default(0)
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mediaFileId])
  @@index([status])
  @@index([createdAt])
  @@map("media_jobs")
}

// =======================================================
// VOTES
// =======================================================

model Vote {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  editionId String
  edition   CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  status VoteStatus @default(VALID)

  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?

  removedReason String?
  removedAt     DateTime?

  removedByAdminId String?
  removedByAdmin   Admin? @relation("VoteRemovedByAdmin", fields: [removedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fraudAlerts FraudAlert[]

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@index([editionId])
  @@index([status])
  @@index([ipAddress])
  @@index([deviceFingerprint])
  @@index([createdAt])
  @@map("votes")
}

// =======================================================
// VOTE ATTEMPTS — TENTATIVES ACCEPTÉES / REFUSÉES
// =======================================================

model VoteAttempt {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  editionId String?
  edition   CompetitionEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?

  allowed Boolean @default(false)
  reason  String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([editionId])
  @@index([ipAddress])
  @@index([deviceFingerprint])
  @@index([allowed])
  @@index([createdAt])
  @@map("vote_attempts")
}

// =======================================================
// PROJECT VIEWS
// =======================================================

model ProjectView {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("project_views")
}

// =======================================================
// SESSIONS
// =======================================================

model Session {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  adminId String?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  tokenHash String
  type      SessionType

  ipAddress String?
  userAgent String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([adminId])
  @@index([tokenHash])
  @@index([type])
  @@index([expiresAt])
  @@map("sessions")
}

// =======================================================
// AUDIT LOGS
// =======================================================

model AuditLog {
  id String @id @default(cuid())

  actorType ActorType

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  adminId String?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  action String

  targetType String?
  targetId   String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorType])
  @@index([userId])
  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@index([targetId])
  @@index([projectId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =======================================================
// FRAUD ALERTS
// =======================================================

model FraudAlert {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  voteId String?
  vote   Vote? @relation(fields: [voteId], references: [id], onDelete: SetNull)

  editionId String?
  edition   CompetitionEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  type     FraudType
  severity FraudSeverity @default(LOW)
  status   FraudStatus   @default(OPEN)

  message String

  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?

  metadata Json?

  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([userId])
  @@index([projectId])
  @@index([voteId])
  @@index([editionId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([ipAddress])
  @@index([deviceFingerprint])
  @@index([createdAt])
  @@map("fraud_alerts")
}

// =======================================================
// IP LIMITS
// =======================================================

model IpLimit {
  id String @id @default(cuid())

  ipAddress String @unique

  voteCount       Int @default(0)
  failedVoteCount Int @default(0)

  lastVoteAt    DateTime?
  lastAttemptAt DateTime?

  riskScore Int @default(0)

  isBlocked   Boolean @default(false)
  blockReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ipAddress])
  @@index([riskScore])
  @@index([isBlocked])
  @@map("ip_limits")
}

// =======================================================
// BANS
// =======================================================

model Ban {
  id String @id @default(cuid())

  type   BanType
  status BanStatus @default(ACTIVE)

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress         String?
  deviceFingerprint String?

  reason String?

  createdByAdminId String?
  createdByAdmin   Admin? @relation("BanCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([userId])
  @@index([ipAddress])
  @@index([deviceFingerprint])
  @@index([createdAt])
  @@map("bans")
}

// =======================================================
// EXPORTS HISTORY
// =======================================================

model ExportHistory {
  id String @id @default(cuid())

  adminId String?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  editionId String?
  edition   CompetitionEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  type   ExportType
  format ExportFormat
  status ExportStatus @default(PENDING)

  fileUrl      String?
  errorMessage String?

  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([editionId])
  @@index([type])
  @@index([format])
  @@index([status])
  @@index([createdAt])
  @@map("exports_history")
}

// =======================================================
// SYSTEM SETTINGS
// =======================================================

model SystemSetting {
  id String @id @default(cuid())

  key         String @unique
  value       String?
  type        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// =======================================================
// NOTIFICATIONS ADMIN
// =======================================================

model Notification {
  id String @id @default(cuid())

  adminId String?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  title   String
  message String
  type    NotificationType @default(INFO)

  isRead Boolean @default(false)

  metadata Json?

  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([adminId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// =======================================================
// SCORE SNAPSHOTS
// =======================================================

model ScoreSnapshot {
  id String @id @default(cuid())

  editionId String
  edition   CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  rank      Int
  voteCount Int

  snapshotType ScoreSnapshotType @default(LIVE)

  createdAt DateTime @default(now())

  @@index([editionId])
  @@index([projectId])
  @@index([rank])
  @@index([snapshotType])
  @@index([createdAt])
  @@map("score_snapshots")
}